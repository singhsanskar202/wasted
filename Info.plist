<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Both identifiers must be declared here or BGTaskScheduler.submit()
	     throws and the task simply never runs. The `processing` mode is what
	     lets the nightly rotation exist at all: only the main app can create or
	     rotate a Live Activity, iOS culls one 8h after creation, and the 8h gap
	     in a person's day is the night they're asleep. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.sanskar.Wasted.refresh</string>
		<string>com.sanskar.Wasted.rotate</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
</dict>
</plist>
